# PostgreSQL (development credentials only)
HTTP_ADDR=:8080
LOG_LEVEL=INFO
SHUTDOWN_TIMEOUT=10s
# Comma-separated CIDRs. Empty means forwarding headers are not trusted.
TRUSTED_PROXY_CIDRS=
DATABASE_URL=postgres://safedrop:safedrop@localhost:5432/safedrop?sslmode=disable

# Storage backend: local or s3. Keep both incoming/ and final/ private.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=safedrop
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me
STORAGE_FORCE_PATH_STYLE=true

# ClamAV clamd TCP endpoint
CLAMD_ADDRESS=localhost:3310

# Maximum streamed upload size: 25 MiB
MAX_UPLOAD_BYTES=26214400

# Per-client token bucket: refill rate per second and maximum burst
RATE_LIMIT_REQUESTS_PER_SECOND=5
RATE_LIMIT_BURST=10

# Compose overrides for container DNS; DATABASE_URL above is for host tools.
COMPOSE_DATABASE_URL=postgres://safedrop:safedrop@postgres:5432/safedrop?sslmode=disable
COMPOSE_STORAGE_ENDPOINT=http://storage:9000
API_PORT=8080
WORKER_CPUS=1.0
WORKER_MEMORY=512m
WORKER_GO_MEMORY_LIMIT=384MiB

# Swap this image and adjust its command/healthcheck if its CLI differs.
# For S3 mode set STORAGE_BACKEND=s3 and run with --profile s3.
# Provision the private STORAGE_BUCKET before using S3 mode.
S3_IMAGE=minio/minio:latest
