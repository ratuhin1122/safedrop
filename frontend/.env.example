# Include the API base path. Use a same-origin reverse proxy in production.
VITE_API_URL=/v1
# Development only: Vite proxies /v1 and /s to the Go service, avoiding CORS.
API_PROXY_TARGET=http://localhost:8080
# Public browser key only. Never put TURNSTILE_SECRET in a VITE_ variable.
VITE_TURNSTILE_SITE_KEY=
